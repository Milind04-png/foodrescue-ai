# FoodRescue AI Environment Configuration

# Server Ports & Host
HOST=127.0.0.1
PORT=8000
VITE_PORT=5173

# Application Environment
NODE_ENV=development
ENVIRONMENT=production

# Database / Storage (Optional Production Cloud)
DATABASE_URL=sqlite:///./foodrescue.db
REDIS_URL=redis://localhost:6379/0

# Geospatial & Weather APIs (Mocked by default for offline evaluation)
WEATHER_API_KEY=mock_weather_token_delhi
MAPS_API_KEY=mock_maps_geocoding_token

# FSSAI Regulatory & Compliance
FSSAI_COMPLIANCE_MODE=STRICT
ARRHENIUS_DECAY_SAFETY_FACTOR=1.15
ENABLE_ZERO_LANDFILL_BIO_ROUTING=true

# Security & CORS
SECRET_KEY=foodrescue_ai_secure_production_secret_key_2026
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
